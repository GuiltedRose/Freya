# Copy to .env, run chmod 600 .env, then edit locally.
# No credentials belong in chat or source control.
# Public RPC endpoint; safe to publish. Provider rate limits still apply.
SOLANA_RPC_URL=https://api.mainnet.solana.com

# Shared collection/learning. Create review templates with .#paper -- --prepare-config.
CRYPTO_BOT_INDEXER_CONFIG=onchain_pipeline.json
CRYPTO_BOT_LEARNING_CONFIG=learning_pipeline.json
CRYPTO_BOT_INDEX_DB=state/onchain/index.sqlite
CRYPTO_BOT_UNIFIED_DB=state/ml/unified.sqlite
CRYPTO_BOT_PAPER_STATE_DIR=state/paper_volume
CRYPTO_BOT_LIVE_STATE_DIR=state/meme_live

# For live trading only, choose ONE signing source with limited funds.
# Collection, paper trading and learning do not require signing credentials.
# Standard Solana CLI JSON keypair file:
SOLANA_KEYPAIR_PATH=
# Or a base58-encoded 64-byte Solana secret key (not a seed phrase):
SOLANA_PRIVATE_KEY=
